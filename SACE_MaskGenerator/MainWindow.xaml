<Window x:Class="SACE_MaskGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SACE_MaskGenerator"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1200"
        Background="LightGray"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#404040">
            <Grid Width="480" Height="480">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <UniformGrid x:Name="pnlNumbers" Grid.Row="0" Grid.Column="0" Columns="1" Rows="8"/>

                <UniformGrid x:Name="grdBoardVisualizer" Grid.Row="0" Grid.Column="1" Rows="8" Columns="8" Background="White"/>

                <UniformGrid x:Name="pnlLetters" Grid.Row="1" Grid.Column="1" Rows="1" Columns="8"/>
            </Grid>
        </Border>

        <Border BorderThickness="1" BorderBrush="Black" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Vertical" Margin="0,25,0,0">
                <TextBlock Text="Cella Selezionata:" FontWeight="Bold"/>
                <TextBlock x:Name="lblSelectedCoord" Text="Nessuna" Margin="0,0,0,10"/>
                
                <Label Content="Valore selezionata:"/>
                <Slider x:Name="slSquareValue" Margin="0,0,0,20"
                        TickFrequency="0.1" IsSnapToTickEnabled="False"
                        ValueChanged="slSquareValue_ValueChanged"
                        Minimum="-1" Value="0" Maximum="1"/>
                <TextBlock Text="{Binding ElementName=slSquareValue, Path=Value, StringFormat={}{0:F2}}" 
                           HorizontalAlignment="Right"/>

                <Separator Margin="0,10"/>

                <Label Content="Maschera:" />
                <TextBox x:Name="txtGeneratedMask" MinWidth="250" HorizontalAlignment="Stretch" MinHeight="200"/>
                <Button Content="Copia" Margin="0,10,0,0" Click="btnCopy_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
